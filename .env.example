# Optional but recommended: GitHub personal access token (no scopes needed,
# "public_repo" read access is enough). Without it, GitHub's API rate-limits
# unauthenticated requests to 60/hour, which can trip during development.
# Create one at https://github.com/settings/tokens -> "Fine-grained tokens"
GITHUB_TOKEN=

# The GitHub username whose repos should be fetched for the Projects section
NEXT_PUBLIC_GITHUB_USERNAME=datnaijakid

# Public links used in the hero + contact section
NEXT_PUBLIC_LINKEDIN_URL=https://linkedin.com/in/your-linkedin
NEXT_PUBLIC_CONTACT_EMAIL=you@example.com
